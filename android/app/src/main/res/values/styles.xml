<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="PassportBrand" parent="Widget.MaterialComponents.TextView">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textColor">@color/passport_subtle</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="PassportHeading" parent="Widget.MaterialComponents.TextView">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">@color/passport_ink</item>
        <item name="android:textSize">28sp</item>
    </style>

    <style name="PassportSectionTitle" parent="Widget.MaterialComponents.TextView">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">@color/passport_ink</item>
        <item name="android:textSize">17sp</item>
    </style>

    <style name="PassportMeta" parent="Widget.MaterialComponents.TextView">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textColor">@color/passport_subtle</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="PassportPrimaryButton" parent="Widget.Material3.Button">
        <item name="android:letterSpacing">0.08</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/passport_surface</item>
        <item name="backgroundTint">@color/passport_ink</item>
        <item name="cornerRadius">2dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetTop">0dp</item>
    </style>

    <style name="PassportOutlineButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:letterSpacing">0.06</item>
        <item name="android:minHeight">46dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/passport_ink</item>
        <item name="backgroundTint">@color/passport_surface</item>
        <item name="cornerRadius">2dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="strokeColor">@color/passport_ink</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="PassportTextButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">40dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/passport_ink</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetTop">0dp</item>
    </style>
</resources>
